Cell[CellGroupData[{

Cell["Demonstrative Usage examples", "Section",
 CellChangeTimes->{{3.995689612974862*^9, 3.995689620991308*^9}, 
   3.995709614821723*^9, 3.995711797486261*^9, {3.995711838698722*^9, 
   3.9957118398543577`*^9}},ExpressionUUID->"9549e40d-0c73-430a-8ee9-\
1093a85e848a"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Canonical Example",
  FontWeight->"Bold"],
 "\nThe interactive example below demonstrates the principal result of this \
notebook. Everything that follows explains how the symbolic Gibbs free-energy \
function is constructed from the canonical OBGEL representation."
}], "Subsection",
 CellFrame->True,
 CellChangeTimes->{
  3.995716882485882*^9, {3.99571758052914*^9, 
   3.9957175922642603`*^9}},ExpressionUUID->"59db78ce-dc7a-41dd-b972-\
d881d5e63d5b"],

Cell["\<\
The following examples show the main object constructed by this notebook: a \
symbolic molar Gibbs free-energy function that can be plotted, \
differentiated, and passed directly to phase-equilibrium calculations.

 An experienced user can immediately take this Gibbs-energy function into a \
common-tangent or phase-diagram calculation. A teacher can use the same \
expression directly in a classroom demonstration.

The data must be loaded as described in the proceeding section. If the \
following command doesn\[CloseCurlyQuote]t work, then the library failed to \
load properly\[LongDash]that is likely due to the library sitting at the \
wrong place in the directory tree.\
\>", "Text",
 CellChangeTimes->{{3.9956897169533567`*^9, 3.995689744437652*^9}, {
  3.995708704974625*^9, 3.99570878678514*^9}, {3.995714685538917*^9, 
  3.995714688546364*^9}},ExpressionUUID->"461b4a43-4e0b-40bc-90a2-\
d19deff7286d"],

Cell[CellGroupData[{

Cell["\<\
1) Compare the Temperature Dependencies of the Molar Free Energies of Mixing \
for the FCC-A1 and Liquid phases.  Explore the Behavior Near the Eutectic \
Point.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9957109377578278`*^9, 3.9957109726461983`*^9}, {
  3.995713133731491*^9, 3.9957131918798113`*^9}, {3.995716943523587*^9, 
  3.995716944347704*^9}, {3.995717002593006*^9, 
  3.99571702662599*^9}},ExpressionUUID->"11baa126-6382-4c04-939b-\
cb20f4cdeca7"],

Cell["\<\
This illustrates the two molar free energies of mixing for Liquid and FCC-A1 \
in the Cu-Ag system.

These phase Gibbs-energy curves are the objects from which phase-equilibrium \
constructions such as common tangents can be made. The Eutectic Point is near \
 1053K.\
\>", "Text",
 CellChangeTimes->{{3.995710843479369*^9, 3.995710926452533*^9}, {
  3.995711385375534*^9, 3.995711387055491*^9}, {3.995714751101688*^9, 
  3.9957147624174147`*^9}},ExpressionUUID->"e0070561-ec7a-4cf5-b9b3-\
88ebd65b293f"],

Cell["", "Text",
 CellChangeTimes->{{3.995714734464942*^9, 
  3.995714746639217*^9}},ExpressionUUID->"6da038c3-0079-43bd-976b-\
2a5ef7406ad3"],

Cell["\<\
The notebook uses absT or temperature as a reminder that thermodynamic \
temperature arguments are absolute temperatures in kelvin. The composition \
axis is xCu because the phase model declares Cu as the independent \
composition variable.\
\>", "Text",ExpressionUUID->"3ece57e6-8f7b-4e60-8c5b-4a1af929c111"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. Show the form of the Molar Gibbs Free Energy for the Cu-Ag FCC A1 phase\
\>", "Subsubsection",
 CellChangeTimes->{{3.99570815525845*^9, 3.995708193587942*^9}, {
  3.995711808685833*^9, 3.995711814516797*^9}, {3.9957169394604197`*^9, 
  3.995716941241275*^9}, {3.995716997727265*^9, 
  3.995716997841218*^9}},ExpressionUUID->"0073da5e-e291-49e0-84b5-\
f49ee734d21d"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.995772199540102*^9, 
  3.995772200359356*^9}},ExpressionUUID->"341d4b8f-0c5f-4c45-8142-\
f68c51085037"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fromOBGELtoCTTFunction", "[", "obgelJSON_", "]"}], ":=", 
  RowBox[{"Function", "[", 
   RowBox[{
    RowBox[{"{", "absT", "}"}], ",", 
    RowBox[{"Evaluate", "[", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", "x", "}"}], ",", 
       RowBox[{"Evaluate", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"molarGibbsFreeEnergy", "[", "obgelJSON", "]"}], "[", 
          "absT", "]"}], "[", "x", "]"}], "]"}]}], "]"}], "]"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"47499514-193c-454f-a3db-233c1663e823"],

Cell[BoxData[
 RowBox[{"With", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gMolarLiquid", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"molarGibbsFreeEnergy", "[", "liquidPbBiJSON", "]"}], "[", 
        "temperature", "]"}], "[", "xBi", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"gMolarHCP", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"molarGibbsFreeEnergy", "[", "hcpPbBiJSON", "]"}], "[", 
        "temperature", "]"}], "[", "xBi", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"gMolarFCC", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"molarGibbsFreeEnergy", "[", "fccPbBiJSON", "]"}], "[", 
        "temperature", "]"}], "[", "xBi", "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"gMolarRhombo", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"molarGibbsFreeEnergy", "[", "rhomboPbBiJSON", "]"}], "[", 
        "temperature", "]"}], "[", "xBi", "]"}]}]}], "\[IndentingNewLine]", 
    "}"}], ",", "\n", " ", 
   RowBox[{"Manipulate", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "gMolarLiquid", ",", "gMolarHCP", ",", "gMolarFCC", ",", 
         "gMolarRhombo"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"xBi", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", 
       RowBox[{"FrameLabel", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"\"\<xBi\>\"", ",", "\"\<G (J/mol)\>\""}], "}"}]}], ",", 
       RowBox[{
       "PlotLabel", "\[Rule]", "\"\<Molar Gibbs Free Energies: Pb-Bi\>\""}], ",", 
       RowBox[{"PlotLegends", "\[Rule]", 
        RowBox[{"Placed", "[", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<Liquid\>\"", ",", "\"\<HCP-A3\>\"", ",", 
            " ", "\"\<FCC-A1\>\"", ",", " ", "\"\<Rhombo-A7\>\""}], "}"}], ",",
           "Right"}], "]"}]}], ",", 
       RowBox[{"BaseStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"FontSize", "\[Rule]", "16"}], "}"}]}], ",", 
       RowBox[{"ImageSize", "\[Rule]", "Large"}]}], "]"}], ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"temperature", ",", " ", "400", ",", " ", 
         InterpretationBox[
          DynamicModuleBox[{Typeset`open = False}, 
           TemplateBox[{"Expression", 
             RowBox[{"Style", "[", 
               DynamicBox[
                FEPrivate`FrontEndResource["FEBitmaps", "IconizeEllipsis"]], 
               "]"}], 
             GridBox[{{
                RowBox[{
                  TagBox["\"Byte count: \"", "IconizedLabel"], 
                  "\[InvisibleSpace]", 
                  TagBox["120", "IconizedItem"]}]}}, 
              GridBoxAlignment -> {"Columns" -> {{Left}}}, DefaultBaseStyle -> 
              "Column", 
              GridBoxItemSize -> {
               "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], 
             Dynamic[Typeset`open]},
            "IconizedObject"]],
          Style["Temperagure (Kelvin)", 16],
          SelectWithContents->True,
          Selectable->False]}], "}"}], ",", "300", ",", " ", "1200"}], 
      "}"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{"SaveDefinitions", "\[Rule]", "True"}], "*)"}], "\n", "  ", 
    "]"}]}], "\n", " ", "]"}]], "Input",
 CellChangeTimes->{{3.9957724644293623`*^9, 3.995772625893496*^9}, {
