Cell[CellGroupData[{

Cell["What the JSON contains", "Section",ExpressionUUID->"3cb0c15d-7a42-4a19-b431-51b27b99a813"],

Cell["\<\
The JSON is intentionally more explicit than the final Mathematica \
expression. It records model structure, composition conventions, temperature \
ranges, reference-state provenance, and the empirical parameterization. \
Exploring the raw Associations is therefore useful when developing readers or \
contributing new systems.\
\>", "Text",ExpressionUUID->"140a3e2e-ef76-473e-a950-d42594034664"],

Cell[BoxData[
 RowBox[{"Dataset", "[", "jsonDataFCC", "]"}]], "Input",
 CellLabel->
  "In[120]:=",ExpressionUUID->"f8749036-07a9-4419-897a-5316e25efc6d"],

Cell[BoxData[
 RowBox[{"Dataset", "[", "\[IndentingNewLine]", 
  RowBox[{"jsonDataFCC", "[", "\"\<compositionVariables\>\"", "]"}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.995708017081606*^9, 3.995708021360517*^9}},
 CellLabel->
  "In[121]:=",ExpressionUUID->"d50d2faa-8a15-46b5-aebc-2a4b332b9a67"],

Cell[BoxData[
 RowBox[{"Dataset", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"jsonDataFCC", "[", "\"\<gibbsEnergyModel\>\"", "]"}], 
    "[", "\"\<expression\>\"", "]"}], "[", "\"\<redlichKisterTerms\>\"", 
   "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.9957080250339813`*^9, 3.9957080300599937`*^9}},
 CellLabel->
  "In[122]:=",ExpressionUUID->"255e5396-38cd-4998-9ea9-4c998aba77d7"]
}, Closed]],

Cell[CellGroupData[{

Cell["Generated Representations (Human Readable Data Descriptions)", "Section",
 CellChangeTimes->{{3.995712572355976*^9, 3.995712592292951*^9}, {
  3.995712637593442*^9, 
  3.995712638853712*^9}},ExpressionUUID->"355fb105-2168-4b9c-be46-\
08fdca0b77fe"],

Cell["\<\
The canonical JSON is the source of thermodynamic data. Human-readable \
representations such as TeX, PDF, and an equation SVG are generated from that \
source rather than maintained as independent data. The full model sheet is \
useful when a reader wants provenance and units; an equation snapshot is \
useful for a quick look.

For example, this PDF contains information and provenance of the FCC-A1 phase \
data\
\>", "Text",
 CellChangeTimes->{{3.995713021609396*^9, 
  3.9957130760169163`*^9}},ExpressionUUID->"5e8b329b-59c3-4f8d-81bc-\
3ef861a17867"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"pdfPath", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
     "obglLibrary", ",", " ", "\"\<data\>\"", ",", " ", "\"\<cu-ag\>\"", ",", 
      " ", "\"\<rendered\>\"", ",", " ", "\"\<fcc-a1.pdf\>\""}], "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"FileExistsQ", "[", "pdfPath", "]"}], ",", " ", 
   RowBox[{"Import", "[", "pdfPath", "]"}], ",", 
   " ", "\"\<PDF not found in current checkout.\>\""}], "]"}]}], "Input",
 CellChangeTimes->{3.995716131624036*^9},
 CellLabel->
  "In[123]:=",ExpressionUUID->"1ed84544-8bcd-4f12-8733-db545cb9aba9"],

Cell["Read the data", "Text",
 CellChangeTimes->{{3.99570815525845*^9, 3.995708193587942*^9}, {
  3.9957082566398697`*^9, 3.9957082604637203`*^9}, {3.995709658290847*^9, 
  3.995709664817669*^9}, {3.995713085670437*^9, 
  3.995713093004394*^9}},ExpressionUUID->"59672234-d973-4b40-a7f8-\
b5267fa3b627"],

Cell[BoxData[
 RowBox[{"TabView", "[", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pdfDescription", " ", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"obglLibrary", ",", "\"\<data\>\"", ",", "\"\<cu-ag\>\"", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"jsonDataFCC", "[", "\"\<representations\>\"", "]"}], 
           "[", "\"\<pdf\>\"", "]"}], "[", "\"\<path\>\"", "]"}]}], "}"}], 
       "]"}]}], "}"}], ",", "\[IndentingNewLine]", " ", 
    RowBox[{"Import", "[", "pdfDescription", "]"}]}], "\[IndentingNewLine]", 
   "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{3.995716137374723*^9},
 CellLabel->
  "In[125]:=",ExpressionUUID->"1b71a85e-1b76-46f8-a9df-8ea7e7ed7d0e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Verification notes", "Section",ExpressionUUID->"58e4970e-6e3a-4cdb-b938-4fff14b640c3"],

Cell["\<\
The complete phase Gibbs-energy model uses the pure-element SGTE reference \
functions documented here only to 3000 K, so the present complete model is \
limited to that range even though some interaction parameters are tabulated \
more broadly. The Cu-Ag model should be checked against the published \
assessment and an independent phase-equilibrium reference before acceptance \
as the first public data exemplar.\
\>", "Text",ExpressionUUID->"fe374be2-4065-4624-b2b4-a0a3227b155b"]
}, Closed]],

Cell[CellGroupData[{

Cell["Future development notes", "Section",ExpressionUUID->"1c2415ec-0d03-4ed3-b958-2c8023f1bb2f"],

Cell["\<\
The current notebook intentionally reflects the infrastructure that exists \
today. Planned changes are recorded without requiring them here: a broader \
empiricalMixingContribution interface above model-specific representations; a \
public/private split when the reader becomes a Wolfram Language package; and \
richer metadata for available, metastable, or deliberately suppressed phase \
models used in thermodynamic what-if experiments.\
\>", "Text",ExpressionUUID->"fc4251e6-4940-45a3-ac4c-5f21ad1716b0"]
}, Closed]]
}, Open  ]]
},
