Cell[TextData[{
 "Plot the behavior of the second derivative for the FCC phase and visualize \
the location where ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          RowBox[{
            SuperscriptBox["\[PartialD]", "2"], 
            SubscriptBox[
             StyleBox["G", "TI"], "mix"]}], 
          RowBox[{"\[PartialD]", 
            SubsuperscriptBox[
             StyleBox["X", "TI"], "Cu", "2"]}]], "\[LongEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\partial^2 G_{\\mbox{mix}}}{\\partial X_{\\mbox{Cu}}^2} = 0", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a951a2d4-5616-4f98-b91c-20fe1be4c1de"]
}], "Text",
 CellChangeTimes->{{3.995711299823021*^9, 3.9957113074589357`*^9}, {
  3.995711585285894*^9, 
  3.995711637258606*^9}},ExpressionUUID->"ed6bda31-9028-4c17-8fa4-\
fc7720568d97"],

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"d2gdx2FCC", "[", "absT", "]"}], "[", "xCu", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"xCu", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"absT", ",", "700", ",", "1500"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"d2gdx2FCC", "[", "absT", "]"}], "[", "xCu", "]"}], "==", 
      "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"xCu", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
