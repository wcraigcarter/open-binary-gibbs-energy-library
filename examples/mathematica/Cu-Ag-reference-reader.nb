Cell[CellGroupData[{

Cell["Documentation", "Section",
 CellChangeTimes->{{3.995709638457871*^9, 
  3.9957096458932133`*^9}},ExpressionUUID->"78d81813-355b-4c6b-b565-\
2c35628f6c9f"],

Cell[CellGroupData[{

Cell["Helper functions", "Subsection",ExpressionUUID->"ee5f2a02-b67d-422c-addb-6979f4fb07c1"],

Cell["\<\
The following functions form the current development reader. They \
deliberately operate on ordinary Mathematica Associations and return ordinary \
symbolic expressions.\
\>", "Text",ExpressionUUID->"ccec06b8-5b19-47c9-9a49-0dee4edefbf7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Temperature basis functions", "Subsection",ExpressionUUID->"4d9f7f35-5a5b-4950-b015-b1054b10dd95"],

Cell[BoxData[
 RowBox[{
  RowBox[{"temperatureBasisFunctions", " ", "=", " ", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<constant\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"T", ",", " ", "term"}], "}"}], ",", " ", "1"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"\"\<temperature\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"T", ",", " ", "term"}], "}"}], ",", " ", "T"}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"\"\<temperatureLogTemperature\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"T", ",", " ", "term"}], "}"}], ",", " ", 
        RowBox[{"T", " ", 
         RowBox[{"Log", "[", "T", "]"}]}]}], "]"}]}], ",", "\n", "   ", 
     RowBox[{"\"\<temperaturePower\>\"", " ", "->", " ", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"T", ",", " ", "term"}], "}"}], ",", " ", 
        RowBox[{"T", "^", 
         RowBox[{"term", "[", "\"\<exponent\>\"", "]"}]}]}], "]"}]}]}], "\n", 
    "   ", "|>"}]}], ";"}]], "Code",
 CellLabel->"In[94]:=",ExpressionUUID->"ef5fc497-ffb7-4a58-8d13-226e49ffbe87"],

Cell["\<\
A temperature-dependence expression is a sum of coefficient times basis \
function. This same operation is used both for reference-state functions and \
for temperature-dependent Redlich-Kister coefficients.\
\>", "Text",ExpressionUUID->"7e963894-5191-468c-942f-512edc65bd57"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"temperatureDependenceExpression", "[", "terms_List", "]"}], "[",
      "T_", "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", "\"\<coefficient\>\"", "]"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"temperatureBasisFunctions", "[", 
           RowBox[{"#", "[", "\"\<basis\>\"", "]"}], "]"}], "[", 
          RowBox[{"T", ",", " ", "#"}], "]"}]}], ")"}], " ", "&"}], " ", "/@",
       " ", "terms"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
     "temperatureSegmentExpression", "[", "segment_Association", "]"}], "[", 
     "T_", "]"}], " ", ":=", "\n", "    ", 
    RowBox[{
     RowBox[{"temperatureDependenceExpression", "[", 
      RowBox[{"segment", "[", "\"\<terms\>\"", "]"}], "]"}], "[", "T", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"temperatureSegmentPiecewise", "[", "segments_List", "]"}], "[", 
    "T_", "]"}], " ", ":=", "\n", "    ", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"temperatureSegmentExpression", "[", "#", "]"}], "[", "T", 
          "]"}], ",", " ", 
         RowBox[{
          RowBox[{"#", "[", "\"\<minimum\>\"", "]"}], " ", "<=", " ", "T", 
          " ", "<=", " ", 
          RowBox[{"#", "[", "\"\<maximum\>\"", "]"}]}]}], "}"}], " ", "&"}], 
      " ", "/@", " ", "segments"}], ")"}], "]"}]}], ";"}]}], "Code",
 CellLabel->"In[95]:=",ExpressionUUID->"4a3e449f-343e-4162-a9d8-7dc749d5c996"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Reference-state contributions", "Subsection",ExpressionUUID->"7aae3af1-9d5e-4078-8a72-795318490f24"],

Cell["\<\
Reference-state contributions are stored in the JSON as a list. In \
Mathematica they are more convenient as an Association keyed by component.\
\>", "Text",ExpressionUUID->"8a253ddc-fa2c-4c9b-9737-b19377a92011"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"referenceStateRule", "[", "refState_Association", "]"}], " ", ":=",
     "\n", "    ", 
    RowBox[{
     RowBox[{"refState", "[", "\"\<component\>\"", "]"}], " ", "->", " ", 
     RowBox[{"KeyDrop", "[", 
      RowBox[{"refState", ",", " ", "\"\<component\>\""}], "]"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"referenceContributionsToAssociation", "[", "jsonData_", "]"}], 
   " ", ":=", 
   RowBox[{"Association", "[", 
    RowBox[{"referenceStateRule", " ", "/@", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"jsonData", "[", "\"\<gibbsEnergyModel\>\"", "]"}], 
       "[", "\"\<expression\>\"", "]"}], 
      "[", "\"\<referenceStateContributions\>\"", "]"}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.9957141209422827`*^9, 3.9957141316031017`*^9}},
 CellLabel->"In[98]:=",ExpressionUUID->"9cc5c078-0499-401c-a50b-e6b8075a0846"],

Cell["\<\
For the current binary solution model, the composition metadata identify \
which component is represented by xCu. The other component receives 1 - xCu; \
the code does not depend on the incidental ordering of the reference-state \
list.\
\>", "Text",ExpressionUUID->"48340633-5ece-4114-8122-9d77fd3996cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"referenceStateContribution", "[", "jsonData_", "]"}], "[", 
     "absT_", "]"}], "[", "x_", "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"referenceAssociation", " ", "=", " ", 
        RowBox[{
        "referenceContributionsToAssociation", "[", "jsonData", "]"}]}], ",", 
       "\n", "   ", "components", ",", " ", "independentComponent", ",", " ", 
       "dependentComponent", ",", " ", "referenceStates"}], "}"}], ",", "\n", 
     "  ", 
     RowBox[{
      RowBox[{"components", " ", "=", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"jsonData", "[", "\"\<components\>\"", "]"}], ",", 
         " ", "\"\<identifier\>\""}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"independentComponent", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"jsonData", "[", "\"\<compositionVariables\>\"", "]"}], "[", 
         
         RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<component\>\"", "]"}]}], ";",
       "\n", "  ", 
      RowBox[{"dependentComponent", " ", "=", " ", 
       RowBox[{"First", "[", 
        RowBox[{"DeleteCases", "[", 
         RowBox[{"components", ",", " ", "independentComponent"}], "]"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"referenceStates", " ", "=", " ", 
       RowBox[{"AssociationMap", "[", "\n", "     ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"temperatureSegmentPiecewise", "[", 
            RowBox[{
             RowBox[{"referenceAssociation", "[", "#", "]"}], 
             "[", "\"\<temperatureSegments\>\"", "]"}], "]"}], "[", "absT", 
           "]"}], " ", "&"}], ",", "\n", "     ", "components"}], "]"}]}], ";",
       "\n", "  ", 
      RowBox[{
       RowBox[{"x", " ", 
        RowBox[{"referenceStates", "[", "independentComponent", "]"}]}], " ", 
       "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", " ", "-", " ", "x"}], ")"}], " ", 
        RowBox[{"referenceStates", "[", "dependentComponent", "]"}]}]}]}]}], 
    "\n", "  ", "]"}]}], ";"}]], "Code",
 CellLabel->
  "In[100]:=",ExpressionUUID->"8e0b479b-c15d-4cb9-b835-63aa75d2e466"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ideal mixing contribution", "Subsection",ExpressionUUID->"2b39868d-bc1e-4b7b-aea8-47a695e5f9b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"xlogx", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"x", " ", 
    RowBox[{"Log", "[", "x", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xlogx", "[", "0", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"xlogx", "[", "1", "]"}], " ", "=", " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"xlogx", "[", "0.0", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"xlogx", "[", "1.0", "]"}], " ", "=", " ", "0.0"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"idealMixing", "[", "absT_", "]"}], "[", "x_", "]"}], " ", ":=", 
    " ", 
    RowBox[{"absT", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"xlogx", "[", "x", "]"}], " ", "+", " ", 
       RowBox[{"xlogx", "[", 
        RowBox[{"1", " ", "-", " ", "x"}], "]"}]}], ")"}]}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"idealMixingContribution", "[", "jsonData_", "]"}], "[", "absT_",
      "]"}], "[", "x_", "]"}], " ", ":=", "\n", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"idealMixingTerm", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"jsonData", "[", "\"\<gibbsEnergyModel\>\"", "]"}], 
         "[", "\"\<expression\>\"", "]"}], "[", "\"\<idealMixingTerm\>\"", 
        "]"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{"Which", "[", "\n", "   ", 
      RowBox[{
       RowBox[{"idealMixingTerm", "[", "\"\<included\>\"", "]"}], ",", "\n", 
       "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"idealMixingTerm", "[", "\"\<gasConstant\>\"", "]"}], 
         "[", "\"\<value\>\"", "]"}], " ", 
        RowBox[{
         RowBox[{"idealMixing", "[", "absT", "]"}], "[", "x", "]"}]}], ",", 
       "\n", "   ", "True", ",", "\n", "   ", "0"}], "\n", "   ", "]"}]}], 
    "\n", "  ", "]"}]}], ";"}]}], "Code",
 CellLabel->
  "In[101]:=",ExpressionUUID->"75a04dd8-7747-4db4-82c4-a45978ace3ff"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Empirical mixing contribution: current Cu-Ag implementation", \
"Subsection",ExpressionUUID->"5583aa95-2a83-4cb0-9349-57a4ae19f6b7"],

Cell["\<\
Redlich-Kister is one particular way of representing an empirical \
contribution to the Gibbs energy of mixing. The current Cu-Ag JSON explicitly \
identifies its Redlich-Kister terms, so the development reader exposes this \
implementation directly.\
\>", "Text",ExpressionUUID->"716e5617-62f4-4163-9738-ac2413cf0a6f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"redlichKisterTerm", "[", "term_Association", "]"}], "[", 
     "absT_", "]"}], " ", ":=", "\n", "    ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"#", "[", "\"\<coefficient\>\"", "]"}], " ", "*", " ", 
         RowBox[{
          RowBox[{"temperatureBasisFunctions", "[", 
           RowBox[{"#", "[", "\"\<basis\>\"", "]"}], "]"}], "[", 
          RowBox[{"absT", ",", " ", "#"}], "]"}]}], ")"}], " ", "&"}], " ", "/@",
       " ", 
      RowBox[{"term", "[", "\"\<temperatureDependence\>\"", "]"}]}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"redlichKisterContribution", "[", "jsonData_", "]"}], "[", 
     "absT_", "]"}], "[", "x_", "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x1", " ", "=", " ", "x"}], ",", " ", 
       RowBox[{"x2", " ", "=", " ", 
        RowBox[{"1", " ", "-", " ", "x"}]}], ",", " ", "terms"}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{
      RowBox[{"terms", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"jsonData", "[", "\"\<gibbsEnergyModel\>\"", "]"}], 
         "[", "\"\<expression\>\"", "]"}], "[", "\"\<redlichKisterTerms\>\"", 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"x1", " ", "x2", " ", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"redlichKisterTerm", "[", "#", "]"}], "[", "absT", "]"}], 
           " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x1", " ", "-", " ", "x2"}], ")"}], "^", 
            RowBox[{"#", "[", "\"\<order\>\"", "]"}]}]}], " ", "&"}], " ", "/@",
          " ", "terms"}], "]"}]}]}]}], "\n", "  ", "]"}]}], ";"}]}], "Code",
 CellLabel->
  "In[106]:=",ExpressionUUID->"9bfb1595-6e33-482e-8ee3-3279c60a579e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Final assembly", "Subsection",ExpressionUUID->"ecc14b0f-17d1-48a3-8a5b-c3e7c7643c11"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"molarGibbsFreeEnergy", "[", "jsonData_", "]"}], "[", "absT_", 
     "]"}], "[", "x_", "]"}], " ", ":=", "\n", "    ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"referenceStateContribution", "[", "jsonData", "]"}], "[", 
      "absT", "]"}], "[", "x", "]"}], " ", "+", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"idealMixingContribution", "[", "jsonData", "]"}], "[", "absT", 
      "]"}], "[", "x", "]"}], " ", "+", "\n", "    ", 
    RowBox[{
     RowBox[{
      RowBox[{"redlichKisterContribution", "[", "jsonData", "]"}], "[", 
      "absT", "]"}], "[", "x", "]"}]}]}], ";"}]], "Code",
 CellLabel->
  "In[108]:=",ExpressionUUID->"86439282-a0dc-4b24-beef-c3aa6eacc2de"],

Cell["\<\
The public conceptual structure we want to preserve is: reference-state \
contribution + ideal mixing contribution + empirical mixing contribution. The \
broader empiricalMixingContribution abstraction is a planned API refinement; \
it is not required by this current development notebook.\
\>", "Text",ExpressionUUID->"d85bad09-ad0a-4904-9295-ed8751a43ad5"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Examples:", "Section",
 CellChangeTimes->{{3.995711006338955*^9, 
  3.995711013068597*^9}},ExpressionUUID->"ac2d268d-a703-4808-a483-\
2723172eb4ef"],

Cell[CellGroupData[{

Cell["Inspect the individual contributions", "Subsection",
 CellChangeTimes->{
  3.995711016684544*^9},ExpressionUUID->"75dfed46-83ff-4af7-8130-\
af7955a2ea3f"],

Cell["Reference state", "Text",ExpressionUUID->"b5fa7cd0-4c6f-4e98-bea4-f1e15f50584b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"referenceStateContribution", "[", "jsonDataFCC", "]"}], "[", 
   "absT", "]"}], "[", "xCu", "]"}]], "Input",
 CellLabel->
  "In[109]:=",ExpressionUUID->"d504ca0a-eda8-442c-8711-81f8b4e8e54b"],

Cell["Ideal mixing", "Text",ExpressionUUID->"5ef38722-cc1a-4c07-a3a3-a6f265463512"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"idealMixingContribution", "[", "jsonDataFCC", "]"}], "[", "absT", 
   "]"}], "[", "xCu", "]"}]], "Input",
 CellLabel->
  "In[110]:=",ExpressionUUID->"d0d34580-52d5-4978-ab9d-5463ec4920e8"],

Cell["Redlich-Kister empirical contribution", "Text",ExpressionUUID->"6b65a31e-7312-464d-8bf8-edf6eb79d035"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"redlichKisterContribution", "[", "jsonDataFCC", "]"}], "[", 
   "absT", "]"}], "[", "xCu", "]"}]], "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"edfb05fc-8448-4f74-9049-9746601cbed6"],

Cell["\<\
Note 1:  The tailing arguments (in this case absT and xCu) specify the \
symbolic form of the variables\[LongDash]they can be anything, but we \
recommend using symbols that help understanding, like xCu\
\>", "Text",
 CellChangeTimes->{{3.995713264112866*^9, 3.995713370882922*^9}, {
  3.995714999939426*^9, 
  3.995714999944294*^9}},ExpressionUUID->"53ca911c-00e6-4f72-9a41-\
810eb13b7a2b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"redlichKisterContribution", "[", "jsonDataFCC", "]"}], "[", 
   "\[Tau]", "]"}], "[", "\[Xi]", "]"}]], "Input",
 CellChangeTimes->{{3.9957136343061457`*^9, 3.9957136392307568`*^9}},
 CellLabel->
  "In[112]:=",ExpressionUUID->"5211ce3f-5fbe-466e-af70-463709562173"],

Cell["\<\
Note 2:  One common failure mode is to assign a value to a symbol that is \
intended to be a variable.

For example, if you do this\[LineSeparator]xCu = 0.67
then this
redlichKisterContribution[jsonDataFCC][absT][xCu]
will no longer appear to be an expression that depends on xCu\[LongDash]and \
you won\[CloseCurlyQuote]t be able to take derivatives of it.
If that happens, you can always:
Clear[xCu] or quick the kernel and start again.
\
\>", "Text",
 CellChangeTimes->{{3.995713264112866*^9, 3.9957134116499233`*^9}, {
  3.995713479472774*^9, 
  3.995713606554103*^9}},ExpressionUUID->"fd2444fa-42ef-4270-9d4a-\
ec9270d4d73a"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Derivatives and thermodynamic use", "Section",ExpressionUUID->"55b57e1c-1b99-4776-9370-db30495a43d6"],

Cell["\<\
The resulting Gibbs-energy function is an ordinary Wolfram Language function. \
Differentiation therefore exposes the composition derivative directly, \
without any special thermodynamic differentiation machinery.
This function operates on functions of the form F[T][X] and the derivatives \
are taken with respect to the composition variable X.\
\>", "Text",
 CellChangeTimes->{{3.99571111024343*^9, 
  3.9957111675212393`*^9}},ExpressionUUID->"b7d16fb8-dd53-4521-ba2d-\
b197e41eac86"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"derivativeFunction", "[", "function_", "]"}], "[", 
    "order_Integer", "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Function", "[", 
    RowBox[{
     RowBox[{"{", "absT", "}"}], ",", " ", 
     RowBox[{"Evaluate", "[", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", "x", "}"}], ",", " ", 
        RowBox[{"Evaluate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Derivative", "[", "order", "]"}], "[", 
           RowBox[{"function", "[", "absT", "]"}], "]"}], "[", "x", "]"}], 
         "]"}]}], "]"}], "]"}]}], "]"}]}], ";"}]], "Code",
 CellLabel->
  "In[113]:=",ExpressionUUID->"28f2b1e1-9ebc-4553-b9ee-ec5f9f408a56"],

Cell["Examples", "Text",
 CellChangeTimes->{{3.995711193624535*^9, 
  3.995711200706995*^9}},ExpressionUUID->"aee3a8c0-88a7-4519-9ea7-\
d79000d3d8b9"],

Cell[BoxData[
 RowBox[{"dgdxFCC", " ", "=", " ", 
  RowBox[{
   RowBox[{"derivativeFunction", "[", 
    RowBox[{"molarGibbsFreeEnergy", "[", "jsonDataFCC", "]"}], "]"}], "[", 
   "1", "]"}]}]], "Input",
 CellChangeTimes->{3.995711203506983*^9},
 CellLabel->
  "In[114]:=",ExpressionUUID->"8ca3ea31-8a29-436d-9dab-d547a9dd4c96"],

Cell[BoxData[
 RowBox[{"d2gdx2FCC", " ", "=", " ", 
  RowBox[{
   RowBox[{"derivativeFunction", "[", 
