     RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
     RowBox[{"ContourStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", 
        RowBox[{"Thickness", "[", "0.01", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<\!\(\*SubscriptBox[\(X\), \(Cu\)]\)\>\"", ",", 
        " ", "\"\<T (K)\>\""}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
  "]"}]], "Input",
