 CellChangeTimes->{{3.995716000808936*^9, 
  3.995716006685144*^9}},ExpressionUUID->"912313f1-089d-445b-b23c-\
b56b847ef11e"],

Cell["", "Text",
 CellChangeTimes->{{3.995714734464942*^9, 
  3.995714746639217*^9}},ExpressionUUID->"6da038c3-0079-43bd-976b-\
2a5ef7406ad3"],

Cell["\<\
The notebook uses absT or temperature as a reminder that thermodynamic \
temperature arguments are absolute temperatures in kelvin. The composition \
axis is xCu because the phase model declares Cu as the independent \
composition variable.\
\>", "Text",ExpressionUUID->"3ece57e6-8f7b-4e60-8c5b-4a1af929c111"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
2. Show the form of the Molar Gibbs Free Energy for the Cu-Ag FCC A1 phase\
\>", "Subsubsection",
 CellChangeTimes->{{3.99570815525845*^9, 3.995708193587942*^9}, {
  3.995711808685833*^9, 3.995711814516797*^9}, {3.9957169394604197`*^9, 
  3.995716941241275*^9}, {3.995716997727265*^9, 
  3.995716997841218*^9}},ExpressionUUID->"0073da5e-e291-49e0-84b5-\
f49ee734d21d"],

Cell[BoxData[
 RowBox[{"TraditionalForm", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"molarGibbsFreeEnergy", "[", "jsonDataFCC", "]"}], "[", "absT", 
    "]"}], "[", "xCu", "]"}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.995718871481504*^9, 3.995718873612359*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"5393beae-3a5e-45b5-a595-9c2854f22324"]
