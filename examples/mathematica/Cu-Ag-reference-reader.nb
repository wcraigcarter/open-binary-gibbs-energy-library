Cell[CellGroupData[{

Cell["Loading Data", "Subsubsection",
 CellChangeTimes->{{3.995709520346314*^9, 3.99570952432126*^9}, 
   3.995709849121995*^9},ExpressionUUID->"47b755e4-fe16-4d1b-9860-\
85be43a3d8d8"],

Cell[BoxData[
 RowBox[{"With", "[", "\n", 
  RowBox[{
   RowBox[{"{", "\n", 
    RowBox[{
     RowBox[{"fccJSON", " ", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "$OBGELBaseDirectory", ",", " ", "\"\<data\>\"", ",", 
         " ", "\"\<cu-ag\>\"", ",", " ", "\"\<phases\>\"", ",", 
         " ", "\"\<fcc-a1.json\>\""}], "}"}], "]"}]}], ",", "\n", 
     RowBox[{"liquidJSON", " ", "=", " ", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "$OBGELBaseDirectory", ",", " ", "\"\<data\>\"", ",", 
         " ", "\"\<cu-ag\>\"", ",", " ", "\"\<phases\>\"", ",", 
         " ", "\"\<liquid.json\>\""}], "}"}], "]"}]}]}], "\n", "}"}], ",", 
   "\n", 
   RowBox[{"Which", "[", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"FileExistsQ", "[", "fccJSON", "]"}], " ", "&&", " ", 
      RowBox[{"FileExistsQ", "[", "liquidJSON", "]"}]}], ",", "\n", 
     RowBox[{
      RowBox[{"jsonDataFCC", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{"fccJSON", ",", " ", "\"\<RawJSON\>\""}], "]"}]}], ";", "\n", 
      
      RowBox[{"jsonDataLiq", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{"liquidJSON", ",", " ", "\"\<RawJSON\>\""}], "]"}]}], ";"}], ",",
      "\n", "True", ",", "\n", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", "\"\<Data files not found:\\n `1`\\n`2`\>\"", 
       "]"}], "[", 
      RowBox[{"fccJSON", ",", "liquidJSON"}], "]"}]}], "\n", "]"}]}], "\n", 
  "]"}]], "Code",
 CellChangeTimes->{{3.9957076695741673`*^9, 3.995707735326346*^9}, {
  3.995709226547183*^9, 3.995709484478265*^9}, {3.995712380963073*^9, 
  3.995712389569223*^9}},
 CellLabel->"In[89]:=",ExpressionUUID->"bfed5ab9-8dc7-4601-ad03-bade00571fde"],

Cell["\<\
The composition variable is declared by the phase model rather than inferred \
from list ordering. For the Cu-Ag FCC phase, the independent variable is xCu, \
the mole fraction of Cu.  If the next command returns xCu and Cu, all the \
data has loaded as it should\
\>", "Text",
 CellChangeTimes->{{3.995709537790963*^9, 3.995709597028041*^9}, {
  3.99571498002507*^9, 
  3.99571498431805*^9}},ExpressionUUID->"ee33af72-946a-42c9-9b24-\
ba7d1c9b67a8"],

Cell[BoxData[{
 RowBox[{"compositionVariable", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"jsonDataFCC", "[", "\"\<compositionVariables\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<name\>\"", "]"}]}], "\n", 
 RowBox[{"compositionComponent", " ", "=", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"jsonDataFCC", "[", "\"\<compositionVariables\>\"", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<component\>\"", 
   "]"}]}]}], "Code",
 CellChangeTimes->{{3.995707753823201*^9, 3.995707755349182*^9}, {
  3.995709572206534*^9, 3.995709572529806*^9}},
 CellLabel->"In[90]:=",ExpressionUUID->"1c5fd6a2-2bf7-4f09-9899-a50590a14c7a"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Demonstrative Usage examples", "Section",
 CellChangeTimes->{{3.995689612974862*^9, 3.995689620991308*^9}, 
   3.995709614821723*^9, 3.995711797486261*^9, {3.995711838698722*^9, 
   3.9957118398543577`*^9}},ExpressionUUID->"9549e40d-0c73-430a-8ee9-\
1093a85e848a"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Canonical Example",
  FontWeight->"Bold"],
 "\nThe interactive example below demonstrates the principal result of this \
notebook. Everything that follows explains how the symbolic Gibbs free-energy \
function is constructed from the canonical OBGEL representation."
}], "Subsection",
 CellFrame->True,
 CellChangeTimes->{
  3.995716882485882*^9, {3.99571758052914*^9, 
   3.9957175922642603`*^9}},ExpressionUUID->"59db78ce-dc7a-41dd-b972-\
d881d5e63d5b"],

Cell["\<\
The following examples show the main object constructed by this notebook: a \
symbolic molar Gibbs free-energy function that can be plotted, \
differentiated, and passed directly to phase-equilibrium calculations.

 An experienced user can immediately take this Gibbs-energy function into a \
common-tangent or phase-diagram calculation. A teacher can use the same \
expression directly in a classroom demonstration.

The data must be loaded as described in the proceeding section. If the \
following command doesn\[CloseCurlyQuote]t work, then the library failed to \
load properly\[LongDash]that is likely due to the library sitting at the \
wrong place in the directory tree.\
\>", "Text",
 CellChangeTimes->{{3.9956897169533567`*^9, 3.995689744437652*^9}, {
  3.995708704974625*^9, 3.99570878678514*^9}, {3.995714685538917*^9, 
  3.995714688546364*^9}},ExpressionUUID->"461b4a43-4e0b-40bc-90a2-\
d19deff7286d"],

Cell[CellGroupData[{

Cell["\<\
1) Compare the Temperature Dependencies of the Molar Free Energies of Mixing \
for the FCC-A1 and Liquid phases.  Explore the Behavior Near the Eutectic \
Point.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9957109377578278`*^9, 3.9957109726461983`*^9}, {
  3.995713133731491*^9, 3.9957131918798113`*^9}, {3.995716943523587*^9, 
  3.995716944347704*^9}, {3.995717002593006*^9, 
  3.99571702662599*^9}},ExpressionUUID->"11baa126-6382-4c04-939b-\
cb20f4cdeca7"],

Cell["\<\
This illustrates the two molar free energies of mixing for Liquid and FCC-A1 \
in the Cu-Ag system.

These phase Gibbs-energy curves are the objects from which phase-equilibrium \
constructions such as common tangents can be made. The Eutectic Point is near \
 1053K.\
\>", "Text",
 CellChangeTimes->{{3.995710843479369*^9, 3.995710926452533*^9}, {
  3.995711385375534*^9, 3.995711387055491*^9}, {3.995714751101688*^9, 
  3.9957147624174147`*^9}},ExpressionUUID->"e0070561-ec7a-4cf5-b9b3-\
88ebd65b293f"],

