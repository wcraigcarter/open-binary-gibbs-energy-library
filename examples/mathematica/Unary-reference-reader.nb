 CellChangeTimes->{3.997445272948552*^9},
 CellLabel->"Out[35]=",ExpressionUUID->"d14cfa1e-d307-450b-8b05-d6a7aa7c96b1"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"examplePbReference", "[", "\"\<functions\>\"", "]"}], 
       "[", "\"\<stableReference\>\"", "]"}], "[", "temperature", "]"}], ",", 
     
     RowBox[{
      RowBox[{
       RowBox[{"examplePbReference", "[", "\"\<functions\>\"", "]"}], 
       "[", "\"\<metastableLiquidReference\>\"", "]"}], "[", "temperature", 
      "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"temperature", ",", 
     RowBox[{"transitionTemperature", "-", "5"}], ",", 
     RowBox[{"transitionTemperature", "+", "5"}]}], "}"}], ",", " ", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Temperarure (K)\>\"", 
      ",", "\"\<Molar Gibbs Free Energy\>\""}], "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Reference\>\"", ",", " ", "\"\<Liquid\>\""}], "}"}]}], ",", 
   
