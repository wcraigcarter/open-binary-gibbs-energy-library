Cell["Molar free energy extraction functions", "Subsection",
 CellChangeTimes->{{3.997362352767692*^9, 
  3.9973623642693872`*^9}},ExpressionUUID->"3b7f137a-bef0-48d4-afda-\
3e6c2e6ffeaf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "molarGibbsReferenceFunction", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"molarGibbsReferenceFunction", "[", "json_Association", "]"}], "[",
    "phaseIdentifier_String", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"phase", "=", " ", 
      RowBox[{
       RowBox[{"json", "[", "\"\<functions\>\"", "]"}], "[", 
       "phaseIdentifier", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"functions", ",", " ", "ranges", ",", " ", "T", ",", 
        RowBox[{"temperatureSegments", "=", 
         RowBox[{"phase", "[", "\"\<temperatureSegments\>\"", "]"}]}], ",", 
        " ", 
        RowBox[{"terms", " ", "=", " ", 
         RowBox[{
          RowBox[{"phase", "[", "\"\<temperatureSegments\>\"", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<terms\>\""}], "]"}], "]"}]}]}], "}"}], ",",
       "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functions", " ", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"temperatureDependenceExpression", "[", "#", "]"}], "[", 
           "T", "]"}], "&"}], "/@", "terms"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ranges", " ", "=", " ", 
        RowBox[{
         RowBox[{"temperatureSegmentsToRanges", "[", "T", "]"}], "/@", 
         "temperatureSegments"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"res", " ", "=", 
        RowBox[{
         RowBox[{"Piecewise", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"functions", ",", "ranges"}], "}"}], "]"}], "]"}], "+", 
         "\[IndentingNewLine]", 
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{"MissingQ", "[", 
            RowBox[{"phase", "[", "\"\<baseFunction\>\"", "]"}], "]"}], ",", 
           "0", ",", "True", ",", 
           RowBox[{"phase", "[", "\"\<baseFunction\>\"", "]"}]}], 
          "]"}]}]}]}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
