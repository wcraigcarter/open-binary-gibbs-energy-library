Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transitionTemperature", " ", "=", " ", 
  RowBox[{"temperature", "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"examplePbReference", "[", "\"\<stableReference\>\"", "]"}], "[",
        "temperature", "]"}], "==", "  ", 
      RowBox[{
       RowBox[{
       "examplePbReference", "[", "\"\<metastableLiquidReference\>\"", "]"}], 
       "[", "temperature", "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"temperature", ",", "300"}], "}"}]}], "]"}]}]}]], "Input",
