Cell[CellGroupData[{

Cell["\<\
Get a data structure for the molar free energies in the library json.\
\>", "Subsubsection",
 CellChangeTimes->{{3.997362497681807*^9, 
  3.997362526326295*^9}},ExpressionUUID->"8af934ad-8d93-46e3-8ab7-\
0e6422dba304"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"molarGibbsReference", "[", "json_Association", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functions", " ", "=", " ", 
        RowBox[{"json", "[", "\"\<functions\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "phases", ",", "\[IndentingNewLine]", 
       "functionsAssociation", ",", "\[IndentingNewLine]", "referencePhase", ",",
        "referenceFunction", ",", "referenceFunctionName", ",", 
       "referencePhaseKey", ",", " ", "result", ",", "T", ",", 
       "\[IndentingNewLine]", "resultExpressions", ",", "resultFunctions", ",",
        "validTemperatureRanges", ",", "minimumValidTemperature", ",", 
       "maximumValidTemperature"}], "\[IndentingNewLine]", "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phases", "=", " ", 
       RowBox[{"Keys", "[", "functions", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"functionsAssociation", " ", "=", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{
         RowBox[{"molarGibbsReferenceFunction", "[", "json", "]"}], ",", 
         "phases"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhase", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"json", "[", "\"\<functions\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"#", ",", "\"\<baseFunction\>\""}], "]"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhaseKey", " ", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "referencePhase", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"referenceFunctionName", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", "referencePhase", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<name\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"referenceFunction", "=", 
       RowBox[{"functionsAssociation", "[", "referencePhaseKey", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"resultExpressions", " ", "=", 
       RowBox[{"functionsAssociation", "/.", 
        RowBox[{"referenceFunctionName", "->", "referenceFunction"}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"resultFunctions", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{
            RowBox[{"{", "T", "}"}], ",", "#"}], "]"}], "&"}], ",", 
         "resultExpressions"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"validTemperatureRanges", " ", "=", " ", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"json", "[", "\"\<functions\>\"", "]"}], "//", "Values"}], ",",
          " ", "\"\<validity\>\""}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"minimumValidTemperature", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
         "validTemperatureRanges", ",", "\"\<minimumTemperature\>\""}], "]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"maximumValidTemperature", " ", "=", " ", 
       RowBox[{"Min", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{
         "validTemperatureRanges", ",", "\"\<maximumTemperature\>\""}], "]"}],
         "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Valid Temperature Range\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"minimumValidTemperature", ",", "maximumValidTemperature"}],
           "}"}]}], ",", 
        RowBox[{"\"\<functions\>\"", "->", "resultFunctions"}]}], "|>"}]}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9972559097632837`*^9, 3.997255969900257*^9}, {
