  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"DirectoryQ", "[", "obglLibrary", "]"}], ",", "\n", 
    RowBox[{"$OBGELBaseDirectory", " ", "=", " ", "obglLibrary"}], ",", "\n", 
    
    RowBox[{"Print", "[", 
     RowBox[{"\"\<OBGEL directory not found: \>\"", ",", " ", "obglLibrary"}],
      "]"}]}], "\n", "]"}], ";"}]}], "Code",
