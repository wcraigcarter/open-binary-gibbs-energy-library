Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"molarGibbsReference", "[", "json_Association", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functions", " ", "=", " ", 
        RowBox[{"json", "[", "\"\<functions\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "phases", ",", "\[IndentingNewLine]", 
       "functionsAssociation", ",", "\[IndentingNewLine]", "referencePhase", ",",
        "referenceFunction", ",", "referenceFunctionName", ",", 
       "referencePhaseKey", ",", " ", "result", ",", "T", ",", 
       "\[IndentingNewLine]", "resultExpressions", ",", "resultFunctions"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phases", "=", " ", 
       RowBox[{"Keys", "[", "functions", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fa", " ", "=", 
       RowBox[{"functionsAssociation", " ", "=", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{"molarGibbsReferenceFunction", "[", "json", "]"}], ",", 
          "phases"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhase", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"json", "[", "\"\<functions\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"#", ",", "\"\<baseFunction\>\""}], "]"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhaseKey", " ", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "referencePhase", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"referenceFunctionName", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", "referencePhase", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<name\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"referenceFunction", "=", 
       RowBox[{"functionsAssociation", "[", "referencePhaseKey", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"re", " ", "=", 
       RowBox[{"resultExpressions", " ", "=", 
        RowBox[{"functionsAssociation", "/.", 
         RowBox[{"referenceFunctionName", "->", "referenceFunction"}]}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"rf", " ", "=", 
       RowBox[{"resultFunctions", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "T", "}"}], ",", "#"}], "]"}], "&"}], ",", 
          "resultExpressions"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AssociateTo", "[", 
       RowBox[{"resultFunctions", ",", " ", 
        RowBox[{"\"\<stableEnvelope\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "T", "}"}], ",", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"Min", "[", 
             RowBox[{"Values", "[", "resultExpressions", "]"}], "]"}], 
            "]"}]}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
