Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"molarGibbsReference", "[", "json_Association", "]"}], ":=", 
   "\[IndentingNewLine]", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"functions", " ", "=", " ", 
        RowBox[{"json", "[", "\"\<functions\>\"", "]"}]}], ",", 
       "\[IndentingNewLine]", "phases", ",", "\[IndentingNewLine]", 
       "functionsAssociation", ",", "\[IndentingNewLine]", "referencePhase", ",",
        "referenceFunction", ",", "referenceFunctionName", ",", 
       "referencePhaseKey", ",", " ", "result", ",", "T", ",", 
       "\[IndentingNewLine]", "resultExpressions", ",", "resultFunctions"}], 
      "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"phases", "=", " ", 
       RowBox[{"Keys", "[", "functions", "]"}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{"fa", " ", "=", 
       RowBox[{"functionsAssociation", " ", "=", 
        RowBox[{"AssociationMap", "[", 
         RowBox[{
          RowBox[{"molarGibbsReferenceFunction", "[", "json", "]"}], ",", 
          "phases"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhase", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"json", "[", "\"\<functions\>\"", "]"}], ",", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"#", ",", "\"\<baseFunction\>\""}], "]"}]}], "&"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"referencePhaseKey", " ", "=", 
       RowBox[{
        RowBox[{"Keys", "[", "referencePhase", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"referenceFunctionName", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Values", "[", "referencePhase", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<name\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"referenceFunction", "=", 
       RowBox[{"functionsAssociation", "[", "referencePhaseKey", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"re", " ", "=", 
       RowBox[{"resultExpressions", " ", "=", 
        RowBox[{"functionsAssociation", "/.", 
         RowBox[{"referenceFunctionName", "->", "referenceFunction"}]}]}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"rf", " ", "=", 
       RowBox[{"resultFunctions", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", "T", "}"}], ",", "#"}], "]"}], "&"}], ",", 
          "resultExpressions"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"AssociateTo", "[", 
       RowBox[{"resultFunctions", ",", " ", 
        RowBox[{"\"\<stableEnvelope\>\"", "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", "T", "}"}], ",", 
           RowBox[{"Evaluate", "[", 
            RowBox[{"Min", "[", 
             RowBox[{"Values", "[", "resultExpressions", "]"}], "]"}], 
            "]"}]}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", "  ", 
     RowBox[{
      RowBox[{
      "renove", " ", "the", " ", "stableEnvelope", " ", "key", " ", "and", " ",
        "construct", " ", "a", " ", "stableEnvelope", " ", "function", " ", 
       "that", " ", "takes", " ", "a", " ", "list", " ", "of", " ", "result", 
       " ", "and", " ", "creates", " ", "the", " ", "function"}], ",", " ", 
      RowBox[{"i", ".", "e", "."}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"stableEnvelope", "[", "json", "]"}], "[", "T", "]"}], ",", 
      " ", 
      RowBox[{
       RowBox[{
       "thus", " ", "the", " ", "stable", " ", "envelope", " ", "and", " ", 
        RowBox[{
         RowBox[{"stablePhase", "[", 
          RowBox[{"molarGibbsReference", "[", "json", "]"}], "]"}], "[", "T", 
         "]"}], " ", "live", " ", "outside", " ", "the", " ", "association", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "molarGibbsReference", " ",
         "return", " ", "only", " ", "the", " ", "phase"}], "-", 
       RowBox[{"specific", " ", "unary", " ", "functions"}]}], ",", 
      RowBox[{
      "and", " ", "that", " ", "stableEnvelope", " ", "and", " ", 
       "stablePhase", " ", "operate", " ", "on", " ", "that", " ", "returned",
