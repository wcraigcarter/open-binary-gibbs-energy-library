Cell["Find the transition temperature:", "Text",
 CellChangeTimes->{{3.997362938193824*^9, 
  3.997362960837771*^9}},ExpressionUUID->"ef94536f-b220-415e-b5ad-\
23deaff2b96d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transitionTemperature", " ", "=", " ", 
  RowBox[{"temperature", "/.", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"examplePbReference", "[", "\"\<functions\>\"", "]"}], 
        "[", "\"\<stableReference\>\"", "]"}], "[", "temperature", "]"}], "==",
       "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"examplePbReference", "[", "\"\<functions\>\"", "]"}], 
        "[", "\"\<metastableLiquidReference\>\"", "]"}], "[", "temperature", 
       "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"temperature", ",", "300"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.997362964351446*^9, 3.9973630133357887`*^9}, {
  3.997436063028254*^9, 3.99743606704777*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"272dd89e-aa62-487e-890b-fd71a78202c0"],

