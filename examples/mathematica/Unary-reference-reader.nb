                RowBox[{"\"\<High Temperature\>\"", "->", 
                 RowBox[{"Last", "[", "#2", "]"}]}]}], "|>"}]}]}], "|>"}], 
           "&"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
