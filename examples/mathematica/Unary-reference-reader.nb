Cell[CellGroupData[{

Cell["Loading Data (Using Pb as an example)", "Subsubsection",
 CellChangeTimes->{{3.995709520346314*^9, 3.99570952432126*^9}, 
   3.995709849121995*^9, {3.9974403350633173`*^9, 
   3.9974403552002*^9}},ExpressionUUID->"47b755e4-fe16-4d1b-9860-\
85be43a3d8d8"],

Cell[BoxData[
 RowBox[{"With", "[", "\n", 
  RowBox[{
   RowBox[{"{", "\n", 
    RowBox[{"unaryPbJSON", " ", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"{", 
       RowBox[{
       "obglLibrary", ",", "\"\<data\>\"", ",", "\"\<unary\>\"", 
        ",", "\"\<pb-standard-reference.json\>\""}], "}"}], "]"}]}], "\n", 
    "}"}], ",", "\n", "\n", 
   RowBox[{"Which", "[", "\n", 
    RowBox[{
     RowBox[{"FileExistsQ", "[", "unaryPbJSON", "]"}], ",", "\n", 
     RowBox[{
      RowBox[{"jsonDataUnaryPb", " ", "=", " ", 
       RowBox[{"Import", "[", 
        RowBox[{"unaryPbJSON", ",", " ", "\"\<RawJSON\>\""}], "]"}]}], ";"}], 
     "\n", ",", "\n", "True", ",", "\n", 
     RowBox[{
      RowBox[{
      "StringTemplate", "[", "\"\<Data files not found:\\n `1`\>\"", "]"}], "[",
       "unaryPbJSON", "]"}]}], "\n", "]"}]}], "\n", "]"}]], "Code",
 CellChangeTimes->{{3.9957076695741673`*^9, 3.995707735326346*^9}, {
  3.995709226547183*^9, 3.995709484478265*^9}, {3.995712380963073*^9, 
  3.995712389569223*^9}, {3.997193773260108*^9, 3.997193812179034*^9}, {
