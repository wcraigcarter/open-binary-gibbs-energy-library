Cell[CellGroupData[{
Cell["Open Binary Gibbs Energy Library: Unary Reference Reader", "Title",
 CellChangeTimes->{{3.997193421456153*^9, 
  3.9971934346690607`*^9}},ExpressionUUID->"575d349e-7dd0-4bf1-94d1-\
dd8dcc935751"],

Cell["\<\
Development exemplar \[LongDash] this notebook is intended to demonstrate the \
current OBGEL JSON reader and will evolve with the schema and reference \
implementation.\
\>", "Subtitle",ExpressionUUID->"42729dc2-ce3c-4156-a941-e56500cba972"],

