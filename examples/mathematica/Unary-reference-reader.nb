Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Options", "[", "stabilityEnvelope", "]"}], "=", 
    RowBox[{"{", 
     RowBox[{"\"\<Temperature Resolution\>\"", "->", "1"}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stabilityEnvelope", "[", 
   RowBox[{"molarGibbsReferenceResult_Association", ",", " ", 
    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
  "\[IndentingNewLine]", 
  RowBox[{"Block", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"keys", " ", "=", " ", 
       RowBox[{"Keys", "[", 
        RowBox[{"molarGibbsReferenceResult", "[", "\"\<functions\>\"", "]"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"functions", " ", "=", " ", 
       RowBox[{"Values", "[", 
        RowBox[{"molarGibbsReferenceResult", "[", "\"\<functions\>\"", "]"}], 
        "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"temperatureLow", " ", "=", 
       RowBox[{"First", "[", 
        RowBox[{
        "molarGibbsReferenceResult", "[", "\"\<Valid Temperature Range\>\"", 
         "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"temperatureHigh", "=", 
       RowBox[{"Last", "[", 
        RowBox[{
        "molarGibbsReferenceResult", "[", "\"\<Valid Temperature Range\>\"", 
         "]"}], "]"}]}], ",", "\[IndentingNewLine]", "grid", " ", ",", " ", 
      "gridCount", ",", "functionValuesOnGrid", ",", "hullIndices", ",", 
      "hullPhases", ",", "segments", ",", "\[IndentingNewLine]", 
      "transitionIntervals", ",", "transitionPhases", ",", 
      "transitionTemperatures", ",", "stablePhaseAtT"}], 
     "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"gridCount", " ", "=", " ", 
      RowBox[{"Round", "[", 
       FractionBox[
        RowBox[{"temperatureHigh", "-", "temperatureLow"}], 
        RowBox[{"OptionValue", "[", "\"\<Temperature Resolution\>\"", "]"}]], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"grid", " ", "=", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"temperatureLow", " ", "+", " ", ".001"}], " ", ",", 
        RowBox[{"temperatureHigh", " ", "-", " ", ".001"}], ",", 
        "gridCount"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"functionValuesOnGrid", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Comap", "[", 
         RowBox[{"functions", ",", "#"}], "]"}], "&"}], "/@", "grid"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{"hullIndices", " ", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"PositionSmallest", "[", "#", "]"}], "]"}], "&"}], "/@", 
       "functionValuesOnGrid"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"hullPhases", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"grid", ",", "hullIndices"}], "}"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"segments", " ", "=", " ", 
      RowBox[{"Most", "[", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], "&"}], ",", 
         RowBox[{"{", 
          RowBox[{"hullPhases", ",", 
           RowBox[{"RotateLeft", "[", "hullPhases", "]"}]}], "}"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"transitionIntervals", " ", "=", 
      RowBox[{"Cases", "[", 
       RowBox[{"segments", ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"_", "?", "NumericQ"}], ",", 
             RowBox[{"p1_", "?", "IntegerQ"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"_", "?", "NumericQ"}], ",", 
             RowBox[{"p2_", "?", "IntegerQ"}]}], "}"}]}], "}"}], "/;", 
         RowBox[{"p1", "!=", "p2"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"transitionPhases", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"keys", "[", 
           RowBox[{"[", " ", 
            RowBox[{"Last", "[", 
             RowBox[{"First", "[", "#", "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"keys", "[", 
           RowBox[{"[", 
            RowBox[{"Last", "[", 
             RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}], "]"}]}], "}"}], 
        "&"}], "/@", "transitionIntervals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"transitionTemperatures", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", "temperature", "}"}], ",", "\[IndentingNewLine]", 
          RowBox[{"With", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tdown", " ", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], " ", ",", " ", 
              RowBox[{"tup", " ", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"pdown", " ", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ",", " ", 
              RowBox[{"pup", " ", "=", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "2"}], "]"}], "]"}]}]}], " ", "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"temperature", "/.", 
             RowBox[{"FindRoot", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"functions", "[", 
                  RowBox[{"[", "pdown", "]"}], "]"}], "[", "temperature", 
                 "]"}], "==", " ", 
                RowBox[{
                 RowBox[{"functions", "[", 
                  RowBox[{"[", "pup", "]"}], "]"}], "[", "temperature", 
                 "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"temperature", ",", 
                 RowBox[{"Mean", "[", 
                  RowBox[{"{", 
                   RowBox[{"tdown", ",", "tup"}], " ", "}"}], "]"}], ",", " ",
                  "tdown", ",", "tup"}], "}"}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], 
        "&"}], "/@", "transitionIntervals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"transitionPhases", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"keys", "[", 
           RowBox[{"[", " ", 
            RowBox[{"Last", "[", 
             RowBox[{"First", "[", "#", "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"keys", "[", 
           RowBox[{"[", 
            RowBox[{"Last", "[", 
             RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}], "]"}]}], "}"}], 
        "&"}], "/@", "transitionIntervals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"stablePhaseAtT", "=", "\[IndentingNewLine]", 
      RowBox[{"Block", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"interpolator", ",", "phaseSequence"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"phaseSequence", " ", "=", " ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"hullPhases", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "}"}], ",", " ", 
            RowBox[{"Sequence", "@@", "transitionIntervals"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"hullPhases", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"phaseSequence", " ", "=", " ", 
          RowBox[{"phaseSequence", "/.", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"t_", "?", "NumericQ"}], ",", 
              RowBox[{"pos_", "?", "IntegerQ"}]}], "}"}], ":>", " ", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{"keys", "[", 
               RowBox[{"[", "pos", "]"}], "]"}]}], "}"}]}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Interpolation", "[", 
          RowBox[{"phaseSequence", ",", "\[IndentingNewLine]", 
           RowBox[{"InterpolationOrder", "->", "0"}]}], "]"}]}]}], 
       "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", ";", 
     "\[IndentingNewLine]", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Stable Phase at Temperature\>\"", "->", 
        "stablePhaseAtT"}], ",", 
       RowBox[{"\"\<Transitions\>\"", "->", "\[IndentingNewLine]", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Transition Temperature\>\"", "->", "#1"}], ",", " ", 
